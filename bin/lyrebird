#!/usr/bin/env bash
set -euo pipefail
# Lyrebird launcher — runs the engine CLI inside its own venv.
#
# Resolve the launcher's real location first: `BASH_SOURCE[0]` is the path we were *invoked* by,
# and the documented install is a symlink on PATH (`bin/lb` is one too), so deriving the engine
# directory from the invoked path looked for `~/.local/engine`. `readlink -f` follows the whole
# chain, relative targets included; it has shipped with macOS since 12.3 and the app targets 26.
if ! SELF="$(readlink -f "${BASH_SOURCE[0]}")"; then
  echo "lyrebird: cannot resolve the launcher's own path from '${BASH_SOURCE[0]}'" >&2
  exit 1
fi
ENGINE_DIR="$(dirname "$SELF")/../engine"
if ! ENGINE="$(cd "$ENGINE_DIR" 2>/dev/null && pwd)"; then
  echo "lyrebird: no engine directory beside the launcher (looked for $ENGINE_DIR; launcher is $SELF)" >&2
  exit 1
fi

if [[ ! -x "$ENGINE/.venv/bin/python" ]]; then
  cat >&2 <<EOF
lyrebird: no virtualenv at $ENGINE/.venv

  cd "$ENGINE"
  python3 -m venv .venv && .venv/bin/pip install --require-hashes -r requirements.txt
EOF
  exit 1
fi

exec "$ENGINE/.venv/bin/python" "$ENGINE/cli.py" "$@"
